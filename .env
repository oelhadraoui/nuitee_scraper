# ===========================================================================
# .env - configuration for the Nuitee price competitiveness pipeline
# ===========================================================================
# Copy to `.env` and adjust. Every value below is optional; the defaults in
# src/config.py are production-sane.
# ===========================================================================

# -- logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# -- Nuitee -----------------------------------------------------------------
NUITEE_URL=https://amine-sadik-2911w.nuitee.link/
NUITEE_CURRENCY=MAD
# Hotels priced per city per date. This is the main throughput/coverage dial.
NUITEE_HOTELS_PER_CITY=25
# Parallel tunnel walks. Raise carefully - the tunnel is heavy and stateful.
NUITEE_TUNNEL_CONCURRENCY=3
NUITEE_MAX_SCROLL_SECONDS=420

# -- checkout tunnel (Requirement A) ----------------------------------------
TUNNEL_ENABLED=true
TUNNEL_MAX_PANELS=8
TUNNEL_MAX_RETRIES=2
TUNNEL_RETRY_BACKOFF_SECONDS=3.0
TUNNEL_ROOM_CANDIDATES=3
# Synthetic guest identity used to unlock the final summary panel.
# No real personal data, and no payment is ever submitted.
TUNNEL_FILL_GUEST_DETAILS=true
TUNNEL_GUEST_FIRST_NAME=Amine
TUNNEL_GUEST_LAST_NAME=Benali
TUNNEL_GUEST_EMAIL=reservations.audit@example.com
TUNNEL_GUEST_PHONE=+212600000000
TUNNEL_GUEST_COUNTRY=Morocco
# Accept a price read from an earlier panel if the final one is unreachable.
TUNNEL_ALLOW_PARTIAL_TUNNEL=true
# Screenshot + HTML dump on every tunnel failure. Verbose; use when tuning.
TUNNEL_DEBUG_ARTIFACTS=false

# -- Booking.com ------------------------------------------------------------
BOOKING_CURRENCY=MAD
BOOKING_LANGUAGE=en-us
BOOKING_FUZZY_THRESHOLD=85
BOOKING_FUZZY_THRESHOLD_STRICT=92
BOOKING_MAX_CARDS_TO_SCAN=10
BOOKING_CONCURRENCY=4
BOOKING_MAX_RETRIES=2

# -- horizons (Requirement C) -----------------------------------------------
HORIZON_OFFSETS_DAYS=3,7
HORIZON_MONTHS=3
HORIZON_FALLBACK_MONTHS=2
HORIZON_NIGHTS=1
HORIZON_STEP_DAYS=1
HORIZON_MIN_ROWS_PER_WINDOW=50

# -- data quality (Requirement B) -------------------------------------------
QUALITY_TARGET_CLEAN_HOTELS=1000
QUALITY_MIN_PRICE_MAD=150
QUALITY_MAX_PRICE_MAD=200000
QUALITY_MAX_PRICE_RATIO=12
QUALITY_ENFORCE_TARGET=false

# -- browser / anti-blocking ------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_SLOW_MO_MS=0
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800
BROWSER_TIMEZONE_ID=Africa/Casablanca
BROWSER_BLOCK_RESOURCES=true
BROWSER_BLOCKED_RESOURCE_TYPES=image,media,font

# -- storage ----------------------------------------------------------------
STORAGE_BATCH_SIZE=25
STORAGE_RESUME=true

# -- FX overrides (optional) ------------------------------------------------
# Only used when a page renders a non-MAD price. Refresh periodically.
# FX_RATE_EUR=10.90
# FX_RATE_USD=10.05
# FX_RATE_GBP=12.75
